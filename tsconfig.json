{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* NFR-A6: strict TypeScript. */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* INV-2 depends on the difference between an ABSENT key and a key present
     * with value `undefined`. Without exactOptionalPropertyTypes those two are
     * the same type, and the compiler stops protecting the location-privacy
     * invariant. This flag is load-bearing, not a style preference.
     * See business-rules.md BR-U1-31 and domain-entities.md 4.2. */
    "exactOptionalPropertyTypes": true,

    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@core/*": ["src/core/*"],
      "@ui/*": ["src/ui/*"],
      "@infra/*": ["src/infra/*"],
      "@features/*": ["src/features/*"],
      "@tests/*": ["tests/*"]
    },

    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests"]
}
